# -*- coding: utf-8 -*-
"""
Visual Gifts & NFT для exteraGram

Локальная визуальная симуляция Telegram:
  - дарение подарков;
  - покупка / дарение NFT-подарков;
  - установка NFT в витрину профиля;
  - крафт NFT из осколков подарков и NFT;
  - визуальный баланс Stars и GRAM, регулируется в настройках.

Всё локально: плагин не покупает подарки, не работает с блокчейном
и не меняет реальный аккаунт. В чат уходит только текстовая плашка.

Иконки в настройках ограничены набором, подтверждённым в документации
(plugin-settings / plugin-class): msg_settings, msg_info, msg_list,
msg_edit, msg_text, msg_error, user_search. Нестандартные иконки
в некоторых сборках роняют экран настроек, поэтому здесь их нет.
"""

from typing import Any, Dict, List, Optional

from base_plugin import BasePlugin, MenuItemData, MenuItemType
from android_utils import run_on_ui_thread
from client_utils import get_last_fragment
from ui.alert import AlertDialogBuilder
from ui.bulletin import BulletinHelper
from ui.settings import Header, Input, Selector, Switch, Text, Divider

import json
import random
import time


__id__ = "visual_gifts"
__name__ = "Визуальные подарки и NFT"
__description__ = "Симуляция подарков, покупки и дарения **NFT**, витрины в профиле и крафта, плюс визуальный баланс **Stars** и **GRAM**"
__author__ = "MultiTool"
__version__ = "1.8.1"
__icon__ = "exteraPlugins/1"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.4.3"
__category__ = ["fun", "chats"]


K_STARS = "balance_stars"
K_GRAM = "balance_gram"
K_PRICE_STARS = "price_stars"
K_PRICE_GRAM = "price_gram"
K_CUR = "currency"
K_SPEND = "spend_on_gift"
K_HISTORY = "history_json"
K_HISTORY_LIMIT = "history_limit"

K_NFT_PRICE_STARS = "nft_price_stars"
K_NFT_PRICE_GRAM = "nft_price_gram"
K_NFT_CRAFT_COST = "nft_craft_cost"
K_NFT_CRAFT_ITEMS = "nft_craft_items"
K_NFT_SLOTS = "nft_profile_slots"
K_NFT_SPEND = "spend_on_nft"

DEFAULT_STARS = 1000
DEFAULT_GRAM = 5.0
DEFAULT_PRICE_STARS = 50
DEFAULT_PRICE_GRAM = 0.5
DEFAULT_NFT_PRICE_STARS = 300
DEFAULT_NFT_PRICE_GRAM = 3.0
DEFAULT_NFT_CRAFT_COST = 3
DEFAULT_NFT_CRAFT_ITEMS = 1
DEFAULT_NFT_SLOTS = 3

CURRENCY_ITEMS = ["Stars", "GRAM", "Смешанно"]
NFT_RARITY = [
    ("Обычный", 55, 1.0),
    ("Редкий", 30, 1.5),
    ("Эпический", 12, 2.5),
    ("Легендарный", 3, 5.0),
]
NFT_MODELS = [
    "Фигурка", "Космонавт", "Кот-маг", "Дракончик", "Кристалл",
    "Ракета", "Рыба", "Тигр", "Маска", "Гриб", "Печать", "Сердце",
]
NFT_BACKDROPS = ["Небо", "Золото", "Ночь", "Лава", "Лёд", "Сад"]
NFT_PATTERNS = ["", "Звёзды", "Полосы", "Блёстки", "Клетка"]

GIFT_STORE = [
    ("Роза", 50, 0.5),
    ("Мишка", 150, 1.5),
    ("Кристалл", 500, 5.0),
    ("Трофей", 1500, 15.0),
    ("Сердце", 300, 3.0),
    ("Корона", 5000, 50.0),
]


def _rarity_weights() -> List[float]:
    return [float(row[1]) for row in NFT_RARITY]


class VisualGiftsPlugin(BasePlugin):
    # ------------------------------------------------------------------ #
    # Lifecycle
    # ------------------------------------------------------------------ #
    def on_plugin_load(self):
        self._history: List[Dict[str, Any]] = []
        self._inventory: List[Dict[str, Any]] = []
        self._load_error = ""
        self._menu_ids = []
        self._hook_status = []
        self._hooks = []
        self._gifts = []
        try:
            raw_g = self.get_setting("purchased_gifts", "") or ""
            if raw_g:
                data = json.loads(raw_g)
                if isinstance(data, list):
                    self._gifts = [x for x in data if isinstance(x, dict)]
        except Exception:
            self._gifts = []
        try:
            self._load_history()
            self._load_inventory()
            self._register_menus()
            self._install_native_hooks()
        except Exception as exc:
            self._load_error = "%s: %s" % (type(exc).__name__, exc)
            try:
                self.logger.exception("plugin load failed")
            except Exception:
                pass
        try:
            if self._load_error:
                self._toast_info("Visual Gifts: ошибка — " + self._load_error[:150])
            else:
                self._toast_ok("Visual Gifts загружен")
        except Exception:
            pass

    # ------------------------------------------------------------------ #
    # Native hooks: replace Stars/TON balance in Telegram UI
    # ------------------------------------------------------------------ #
    def _install_native_hooks(self):
        try:
            from base_plugin import MethodHook
            from hook_utils import find_class
        except Exception as exc:
            self._hook_status.append("import: %s" % exc)
            return

        plugin = self
        try:
            StarsController = find_class("org.telegram.ui.Stars.StarsController")
        except Exception:
            StarsController = None
        if StarsController is None:
            self._hook_status.append("StarsController: не найден")
            return

        try:
            StarsAmount = find_class("org.telegram.tgnet.tl.TL_stars$StarsAmount")
        except Exception as exc:
            self._hook_status.append("StarsAmount: %s" % exc)
            StarsAmount = None

        def is_ton(inst):
            try:
                f = inst.getClass().getDeclaredField("ton")
                f.setAccessible(True)
                return bool(f.getBoolean(inst))
            except Exception:
                return False

        def local_value(inst):
            try:
                return int(plugin._gram() if is_ton(inst) else plugin._stars())
            except Exception:
                return 0

        class BalanceAfterHook(MethodHook):
            def after_hooked_method(self, param):
                try:
                    res = param.getResult()
                    if res is None or StarsAmount is None:
                        return
                    if not hasattr(res, "amount"):
                        return
                    param.setResult(StarsAmount.ofStars(local_value(param.thisObject)))
                except Exception:
                    pass

        class UpdateBalanceHook(MethodHook):
            def after_hooked_method(self, param):
                try:
                    if StarsAmount is None:
                        return
                    param.thisObject.balance = StarsAmount.ofStars(local_value(param.thisObject))
                except Exception:
                    pass

        for name, handler in (
            ("getBalance", BalanceAfterHook),
            ("updateBalance", UpdateBalanceHook),
        ):
            try:
                res = self.hook_all_methods(StarsController, name, handler())
                if res:
                    self._hooks.extend(res)
                    self._hook_status.append("%s: ок (%d)" % (name, len(res)))
                else:
                    self._hook_status.append("%s: нет метода" % name)
            except Exception as exc:
                self._hook_status.append("%s: %s" % (name, type(exc).__name__))

        class PurchaseHook(MethodHook):
            def before_hooked_method(self, param):
                try:
                    param.setResult(None)
                except Exception:
                    pass
                try:
                    plugin._on_visual_purchase(param)
                except Exception:
                    pass

        for name in ("buyGift", "buyStarGift", "buyPremiumGift", "buyResellingGift"):
            try:
                res = self.hook_all_methods(StarsController, name, PurchaseHook())
                if res:
                    self._hooks.extend(res)
                    self._hook_status.append("%s: ок (%d)" % (name, len(res)))
                else:
                    self._hook_status.append("%s: нет метода" % name)
            except Exception as exc:
                self._hook_status.append("%s: %s" % (name, type(exc).__name__))

    def _on_visual_purchase(self, param):
        method_name = ""
        try:
            method_name = str(param.method.getName())
        except Exception:
            pass

        idx_map = {
            "buyGift": 2,
            "buyStarGift": 3,
            "buyPremiumGift": 0,
            "buyResellingGift": 2,
        }
        dialog_id = None
        di = idx_map.get(method_name)
        try:
            if di is not None and di < len(param.args):
                dialog_id = param.args[di]
        except Exception:
            dialog_id = None

        title = ""
        number = None
        for a in list(param.args):
            if a is None:
                continue
            try:
                if not title and hasattr(a, "title"):
                    title = str(getattr(a, "title") or "")
            except Exception:
                pass
            try:
                if number is None and hasattr(a, "id"):
                    number = int(getattr(a, "id") or 0)
            except Exception:
                pass

        if not title:
            title = "Подарок"
        label = "%s №%d" % (title, number) if number else title

        try:
            price = 0
            for a in list(param.args):
                if a is not None and hasattr(a, "stars"):
                    try:
                        price = int(getattr(a, "stars") or 0)
                        break
                    except Exception:
                        pass
            if not price:
                price = max(0, self._int_setting(K_PRICE_STARS, DEFAULT_PRICE_STARS))
            spent = self._spend_amount(price, 0.0, K_SPEND, respect_switch=False)
            if spent is not None:
                self._push_history("Покупка: " + label, "−" + self._price_text(spent))
            else:
                self._push_history("Покупка без списания: " + label, "нет баланса")
        except Exception:
            pass

        try:
            entry = {
                "title": title,
                "number": number or 0,
                "to": str(dialog_id),
                "ts": int(time.time()),
            }
            self._gifts.insert(0, entry)
            self._gifts = self._gifts[:100]
            self.set_setting("purchased_gifts", json.dumps(self._gifts, ensure_ascii=False))
        except Exception:
            pass

        for a in reversed(list(param.args)):
            if a is not None and hasattr(a, "run"):
                try:
                    a.run(True, None)
                    break
                except Exception:
                    continue

        try:
            if dialog_id is not None:
                self._send_text(
                    dialog_id,
                    "Вы приобрели подарок: %s\nСписано: %s\nОстаток: %s Stars"
                    % (label, self._price_text(spent) if spent else "0", self._fmt_stars(self._stars())),
                )
        except Exception:
            pass

        try:
            self._toast_ok(
                "Подарок: %s · остаток %s Stars" % (label, self._fmt_stars(self._stars()))
            )
        except Exception:
            pass

    def _register_menus(self):
        try:
            self._menu_ids.append(
                self.add_menu_item(
                    MenuItemData(
                        menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                        text="Подарить подарок",
                        subtext="Визуально, без реальной оплаты",
                        icon="msg_settings",
                        on_click=self._on_menu_gift,
                        priority=6,
                    )
                )
            )
        except Exception as exc:
            self._load_error = "menu gift: %s: %s" % (type(exc).__name__, exc)
        try:
            self._menu_ids.append(
                self.add_menu_item(
                    MenuItemData(
                        menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                        text="Подарить NFT",
                        subtext="NFT из инвентаря",
                        icon="msg_list",
                        on_click=self._on_menu_nft,
                        priority=5,
                    )
                )
            )
        except Exception as exc:
            if not self._load_error:
                self._load_error = "menu nft: %s: %s" % (type(exc).__name__, exc)
        for menu_type, text, handler in (
            (MenuItemType.DRAWER_MENU, "Мои звёзды и GRAM", self._on_main_menu),
            (MenuItemType.MAIN_MENU, "Мои звёзды и GRAM", self._on_main_menu),
        ):
            try:
                self._menu_ids.append(
                    self.add_menu_item(
                        MenuItemData(
                            menu_type=menu_type,
                            text=text,
                            subtext="Локальный баланс и маркет",
                            icon="msg_settings",
                            on_click=handler,
                            priority=4,
                        )
                    )
                )
            except Exception as exc:
                if not self._load_error:
                    self._load_error = "menu main: %s: %s" % (type(exc).__name__, exc)

    # ------------------------------------------------------------------ #
    # Main menu (app drawer) entry
    # ------------------------------------------------------------------ #
    def _on_main_menu(self, *args):
        try:
            self._open_stars_menu()
        except Exception as exc:
            try:
                self._toast_info("Ошибка меню: %s: %s" % (type(exc).__name__, exc))
            except Exception:
                pass

    def _open_stars_menu(self):
        builder = self._dialog()
        if builder is None:
            self._toast_info("Не удалось открыть окно")
            return
        builder.set_title("Мои звёзды и GRAM")
        builder.set_message(
            "Баланс: %s Stars · %s GRAM\nПодарков в истории: %d · NFT: %d"
            % (
                self._fmt_stars(self._stars()),
                self._fmt_gram(self._gram()),
                len(self._history),
                len(self._inventory),
            )
        )
        options = [
            "Пополнить на 500 Stars",
            "Пополнить на 5 000 Stars",
            "Пополнить на 10 GRAM",
            "Мои подарки",
        ]

        def on_pick(bld, which):
            bld.dismiss()
            if which == 0:
                self._add_stars(500)
            elif which == 1:
                self._add_stars(5000)
            elif which == 2:
                self._add_gram(10.0)
            else:
                self._open_gifts_dialog()

        builder.set_items(options, on_pick)
        builder.set_negative_button("Закрыть", lambda b, w: b.dismiss())
        builder.show()
        builder.set_cancelable(True)

    def _open_gifts_dialog(self):
        builder = self._dialog()
        if builder is None:
            return
        builder.set_title("Мои подарки")
        if not self._gifts:
            builder.set_message("Пока нет купленных подарков.")
        else:
            lines = []
            for g in self._gifts[:25]:
                lines.append("%s - %s" % (g.get("title", "Подарок"), g.get("number", 0)))
            builder.set_message("\n".join(lines))
        builder.set_positive_button("Закрыть", lambda b, w: b.dismiss())
        builder.show()
        builder.set_cancelable(True)

    def _open_gift_market(self):
        builder = self._dialog()
        if builder is None:
            return
        names = ["%s — %s Stars" % (name, self._fmt_stars(price)) for name, price, _p in GIFT_STORE]
        builder.set_title("Магазин подарков")
        builder.set_message("Баланс: %s Stars · %s GRAM" % (self._fmt_stars(self._stars()), self._fmt_gram(self._gram())))

        def on_pick(bld, which):
            bld.dismiss()
            self._market_buy(GIFT_STORE[which])

        builder.set_items(names, on_pick)
        builder.set_negative_button("Назад", lambda b, w: b.dismiss())
        builder.show()
        builder.set_cancelable(True)

    def _market_buy(self, entry):
        try:
            name, price_stars, price_gram = entry
            spent = self._spend_amount(int(price_stars), float(price_gram), K_SPEND)
            if spent is None:
                self._toast_info("Недостаточно баланса")
                return
            self._push_history("Покупка: " + name, "−" + self._price_text(spent))
            builder = self._dialog()
            if builder is None:
                self._toast_ok("Куплено: " + name)
                return
            builder.set_title("Подарок куплен")
            builder.set_message(
                "%s\n\nСписано: %s\nОстаток: %s Stars · %s GRAM"
                % (name, self._price_text(spent), self._fmt_stars(self._stars()), self._fmt_gram(self._gram()))
            )
            builder.set_positive_button("Готово", lambda b, w: b.dismiss())
            builder.show()
            builder.set_cancelable(True)
        except Exception as exc:
            try:
                self._toast_info("Ошибка покупки: %s: %s" % (type(exc).__name__, exc))
            except Exception:
                pass

    def _open_nft_market(self):
        self._buy_nft(install=False)

    def _open_inventory_dialog(self):
        builder = self._dialog()
        if builder is None:
            return
        builder.set_title("Мой инвентарь")
        if not self._inventory:
            builder.set_message("Пока пусто — купите NFT в магазине.")
            builder.set_positive_button("ОК", lambda b, w: b.dismiss())
            builder.show()
            builder.set_cancelable(True)
            return

        def on_pick(bld, which):
            bld.dismiss()
            self._nft_actions(self._inventory[which].get("id"))

        builder.set_items([self._nft_label(x) for x in self._inventory[:20]], on_pick)
        builder.set_negative_button("Закрыть", lambda b, w: b.dismiss())
        builder.show()
        builder.set_cancelable(True)

    def _open_history_dialog(self):
        builder = self._dialog()
        if builder is None:
            return
        builder.set_title("История")
        if not self._history:
            builder.set_message("Пока пусто.")
        else:
            lines = ["%s — %s" % (h.get("title", ""), h.get("sub", "")) for h in self._history[:25]]
            builder.set_message("\n".join(lines))
        builder.set_positive_button("Закрыть", lambda b, w: b.dismiss())
        builder.show()
        builder.set_cancelable(True)

    def on_plugin_unload(self):
        for item_id in getattr(self, "_menu_ids", []):
            try:
                self.remove_menu_item(item_id)
            except Exception:
                self.logger.exception("remove menu item failed")

    # ------------------------------------------------------------------ #
    # Settings
    # ------------------------------------------------------------------ #
    def create_settings(self) -> List[Any]:
        items: List[Any] = []
        try:
            err = getattr(self, "_load_error", "")
            if err:
                items.append(Header(text="Диагностика"))
                items.append(Text(text="Ошибка: " + str(err)[:300], icon="msg_error", red=True))
                items.append(Text(text="Полный текст — в logcat, тег plugin.visual_gifts", icon="msg_info"))
                items.append(Divider())
        except Exception:
            pass
        try:
            items.extend(self._build_settings())
        except Exception as exc:
            items.append(Header(text="Ошибка настроек"))
            items.append(
                Text(text="%s: %s" % (type(exc).__name__, exc), icon="msg_error", red=True)
            )
        return items

    def _build_settings(self) -> List[Any]:
        return [
            Header(text="Звёзды"),
            Input(
                key=K_STARS,
                text="Баланс Stars",
                default=str(DEFAULT_STARS),
                subtext="Целое число, например 2500",
                icon="msg_edit",
            ),
            Text(text="Пополнить +100 Stars", icon="msg_edit", accent=True,
                 on_click=lambda *a: self._add_stars(100)),
            Text(text="Пополнить +1 000 Stars", icon="msg_edit", accent=True,
                 on_click=lambda *a: self._add_stars(1000)),
            Text(text="Пополнить +10 000 Stars", icon="msg_edit", accent=True,
                 on_click=lambda *a: self._add_stars(10000)),
            Divider(),
            Header(text="GRAM"),
            Input(
                key=K_GRAM,
                text="Баланс GRAM",
                default=str(DEFAULT_GRAM),
                subtext="Дробное число, например 5.25",
                icon="msg_edit",
            ),
            Text(text="Пополнить +1 GRAM", icon="msg_edit", accent=True,
                 on_click=lambda *a: self._add_gram(1.0)),
            Text(text="Пополнить +10 GRAM", icon="msg_edit", accent=True,
                 on_click=lambda *a: self._add_gram(10.0)),
            Divider(),
            Text(
                text="Показать состояние (диагностика)",
                subtext="Хуки и реальные значения",
                icon="msg_info",
                on_click=self._show_state,
            ),
        ]

    # ------------------------------------------------------------------ #
    # Numeric helpers
    # ------------------------------------------------------------------ #
    def _num(self, raw: Any, default: float) -> float:
        try:
            text = str(raw).replace(",", ".").replace(" ", "").strip()
            return float(text)
        except Exception:
            return float(default)

    def _int_setting(self, key: str, default: int) -> int:
        return int(self._num(self.get_setting(key, str(default)), default))

    def _float_setting(self, key: str, default: float) -> float:
        return self._num(self.get_setting(key, str(default)), default)

    def _stars(self) -> int:
        return max(0, self._int_setting(K_STARS, DEFAULT_STARS))

    def _gram(self) -> float:
        return max(0.0, self._float_setting(K_GRAM, DEFAULT_GRAM))

    def _fmt_stars(self, value: float) -> str:
        return "{:,}".format(int(value)).replace(",", " ")

    def _fmt_gram(self, value: float) -> str:
        text = ("%.4f" % float(value)).rstrip("0").rstrip(".")
        return text if text and text != "-" else "0"

    def _on_stars_changed(self, *args):
        value = args[-1] if args else ""
        try:
            n = max(0, int(self._num(value, self._stars())))
            self.set_setting(K_STARS, str(n))
            self._toast_info("Баланс Stars: " + self._fmt_stars(n))
        except Exception:
            self.logger.exception("stars change failed")

    def _on_gram_changed(self, *args):
        value = args[-1] if args else ""
        try:
            n = max(0.0, self._num(value, self._gram()))
            self.set_setting(K_GRAM, self._fmt_gram(n))
            self._toast_info("Баланс GRAM: " + self._fmt_gram(n))
        except Exception:
            self.logger.exception("gram change failed")

    def _price_text(self, spent) -> str:
        stars_part, gram_part = spent
        parts = []
        if stars_part:
            parts.append("%s Stars" % self._fmt_stars(stars_part))
        if gram_part:
            parts.append("%s GRAM" % self._fmt_gram(gram_part))
        return " + ".join(parts) if parts else "бесплатно"

    # ------------------------------------------------------------------ #
    # UI helpers
    # ------------------------------------------------------------------ #
    def _toast_info(self, text: str):
        try:
            BulletinHelper.show_info(text, get_last_fragment())
        except Exception:
            self.logger.exception("bulletin info failed")

    def _toast_ok(self, text: str):
        try:
            BulletinHelper.show_success(text, get_last_fragment())
        except Exception:
            self.logger.exception("bulletin success failed")

    def _dialog(self) -> Optional[AlertDialogBuilder]:
        try:
            fragment = get_last_fragment()
            if fragment is None:
                return None
            activity = fragment.getParentActivity()
            if activity is None:
                return None
            return AlertDialogBuilder(activity)
        except Exception:
            self.logger.exception("dialog create failed")
            return None

    # ------------------------------------------------------------------ #
    # Settings sub-pages
    # ------------------------------------------------------------------ #
    def _show_state(self, *args):
        try:
            raw_stars = self.get_setting(K_STARS, "<нет>")
            raw_gram = self.get_setting(K_GRAM, "<нет>")
            raw_spend = self.get_setting(K_SPEND, "<нет>")
            info = (
                "get_setting Stars: %r\n"
                "get_setting GRAM: %r\n"
                "Списывать: %r\n\n"
                "Расчёт Stars: %s\n"
                "Расчёт GRAM: %s\n\n"
                "Пунктов меню: %d\n"
                "Ошибка загрузки: %s\n\n"
                "Последнее пополнение: %s\n\n"
                "Хуки: %s"
                % (
                    raw_stars,
                    raw_gram,
                    raw_spend,
                    self._fmt_stars(self._stars()),
                    self._fmt_gram(self._gram()),
                    len(getattr(self, "_menu_ids", []) or []),
                    (getattr(self, "_load_error", "") or "нет"),
                    (getattr(self, "_last_action", "") or "не было"),
                    "; ".join(getattr(self, "_hook_status", []) or ["нет"]),
                )
            )
            builder = self._dialog()
            if builder is None:
                self._toast_info(info.replace("\n", " | ")[:300])
                return
            builder.set_title("Состояние плагина")
            builder.set_message(info)
            builder.set_positive_button("ОК", lambda b, w: b.dismiss())
            builder.show()
            builder.set_cancelable(True)
        except Exception as exc:
            try:
                self._toast_info("Диагностика не удалась: %s: %s" % (type(exc).__name__, exc))
            except Exception:
                pass

    def _balance_page(self) -> List[Any]:
        return [
            Header(text="Визуальный баланс"),
            Text(text="Stars: " + self._fmt_stars(self._stars()), icon="msg_info", accent=True),
            Text(text="GRAM: " + self._fmt_gram(self._gram()), icon="msg_info", accent=True),
            Text(text="NFT в инвентаре: %d" % len(self._inventory), icon="msg_list"),
            Text(text="Операций в истории: %d" % len(self._history), icon="msg_list"),
            Text(text="Значения редактируются в основных настройках плагина.", icon="msg_info"),
        ]

    def _topup_page(self) -> List[Any]:
        return [
            Header(text="Пополнить баланс"),
            Text(text="+100 Stars", icon="msg_edit", accent=True, on_click=lambda *a: self._add_stars(100)),
            Text(text="+1 000 Stars", icon="msg_edit", accent=True, on_click=lambda *a: self._add_stars(1000)),
            Text(text="+1 GRAM", icon="msg_edit", accent=True, on_click=lambda *a: self._add_gram(1.0)),
            Text(text="+10 GRAM", icon="msg_edit", accent=True, on_click=lambda *a: self._add_gram(10.0)),
            Divider(),
            Text(text="Сбросить баланс", icon="msg_error", red=True, on_click=self._reset_balance),
        ]

    def _add_stars(self, amount: int):
        try:
            before = self._stars()
            after = before + int(amount)
            self.set_setting(K_STARS, str(after), reload_settings=True)
            check = self.get_setting(K_STARS, "<нет>")
            self._last_action = "Stars %s -> %s (в настройках: %r)" % (
                self._fmt_stars(before), self._fmt_stars(after), check)
            self._toast_ok("Stars: %s -> %s" % (self._fmt_stars(before), self._fmt_stars(after)))
        except Exception:
            self.logger.exception("add stars failed")

    def _add_gram(self, amount: float):
        try:
            before = self._gram()
            after = before + float(amount)
            self.set_setting(K_GRAM, self._fmt_gram(after), reload_settings=True)
            check = self.get_setting(K_GRAM, "<нет>")
            self._last_action = "GRAM %s -> %s (в настройках: %r)" % (
                self._fmt_gram(before), self._fmt_gram(after), check)
            self._toast_ok("GRAM: %s -> %s" % (self._fmt_gram(before), self._fmt_gram(after)))
        except Exception:
            self.logger.exception("add gram failed")

    def _reset_balance(self, *args):
        try:
            self.set_setting(K_STARS, str(DEFAULT_STARS), reload_settings=False)
            self.set_setting(K_GRAM, self._fmt_gram(DEFAULT_GRAM), reload_settings=True)
            self._toast_info("Баланс сброшен")
        except Exception:
            self.logger.exception("reset balance failed")

    # ------------------------------------------------------------------ #
    # History
    # ------------------------------------------------------------------ #
    def _load_history(self):
        self._history = []
        try:
            raw = self.get_setting(K_HISTORY, "") or ""
            if raw:
                data = json.loads(raw)
                if isinstance(data, list):
                    self._history = [x for x in data if isinstance(x, dict)]
        except Exception:
            self.logger.exception("history parse failed")

    def _save_history(self):
        try:
            limit = max(1, self._int_setting(K_HISTORY_LIMIT, 150))
            self._history = self._history[:limit]
            self.set_setting(K_HISTORY, json.dumps(self._history, ensure_ascii=False))
        except Exception:
            self.logger.exception("history save failed")

    def _push_history(self, title: str, sub: str):
        self._history.insert(0, {"title": title, "sub": sub, "ts": int(time.time())})
        self._save_history()

    def _clear_history(self, *args):
        self._history = []
        self.set_setting(K_HISTORY, "")
        self._toast_info("История очищена")

    def _history_page(self) -> List[Any]:
        items: List[Any] = [Header(text="История операций")]
        if not self._history:
            items.append(Text(text="Пока пусто", icon="msg_info"))
            return items
        for entry in self._history[:40]:
            items.append(
                Text(
                    text=entry.get("title", "Операция"),
                    subtext=entry.get("sub", ""),
                    icon="msg_list",
                )
            )
        return items

    # ------------------------------------------------------------------ #
    # NFT inventory
    # ------------------------------------------------------------------ #
    def _load_inventory(self):
        self._inventory = []
        try:
            raw = self.get_setting("nft_inventory", "") or ""
            if raw:
                data = json.loads(raw)
                if isinstance(data, list):
                    self._inventory = [x for x in data if isinstance(x, dict)]
        except Exception:
            self.logger.exception("inventory parse failed")

    def _save_inventory(self):
        try:
            self.set_setting("nft_inventory", json.dumps(self._inventory, ensure_ascii=False))
        except Exception:
            self.logger.exception("inventory save failed")

    def _next_id(self) -> int:
        best = 0
        for item in self._inventory:
            try:
                best = max(best, int(item.get("id", 0)))
            except Exception:
                continue
        return best + 1

    def _make_nft(self) -> Dict[str, Any]:
        rarities = [row[0] for row in NFT_RARITY]
        rarity = random.choices(rarities, weights=_rarity_weights(), k=1)[0]
        multiplier = next(row[2] for row in NFT_RARITY if row[0] == rarity)
        model = random.choice(NFT_MODELS)
        backdrop = random.choice(NFT_BACKDROPS)
        pattern = random.choice(NFT_PATTERNS)
        number = random.randint(1, 9999)
        return {
            "id": self._next_id(),
            "name": "%s #%04d" % (model, number),
            "model": model,
            "rarity": rarity,
            "backdrop": backdrop,
            "pattern": pattern,
            "value": int(DEFAULT_NFT_PRICE_STARS * multiplier),
            "slot": 0,
            "created": int(time.time()),
        }

    def _nft_label(self, item: Dict[str, Any]) -> str:
        return "%s — %s" % (item.get("name", "NFT"), item.get("rarity", ""))

    def _nft_sub(self, item: Dict[str, Any]) -> str:
        slot = int(item.get("slot", 0) or 0)
        where = " · слот %d" % slot if slot else ""
        return "%s · фон: %s%s" % (
            item.get("backdrop", "—"),
            item.get("pattern", "") or "без узора",
            where,
        )

    # ------------------------------------------------------------------ #
    # NFT sub-pages
    # ------------------------------------------------------------------ #
    def _nft_shop_page(self) -> List[Any]:
        price_stars = max(0, self._int_setting(K_NFT_PRICE_STARS, DEFAULT_NFT_PRICE_STARS))
        price_gram = max(0.0, self._float_setting(K_NFT_PRICE_GRAM, DEFAULT_NFT_PRICE_GRAM))
        return [
            Header(text="Магазин NFT"),
            Text(
                text="Купить случайный NFT",
                subtext="Цена: %s Stars / %s GRAM" % (self._fmt_stars(price_stars), self._fmt_gram(price_gram)),
                icon="msg_list",
                accent=True,
                on_click=self._buy_nft_click,
            ),
            Text(
                text="Купить и установить в профиль",
                subtext="Сразу займёт свободный слот витрины",
                icon="msg_info",
                on_click=self._buy_nft_install_click,
            ),
            Divider(),
            Text(
                text="Баланс: %s Stars · %s GRAM" % (self._fmt_stars(self._stars()), self._fmt_gram(self._gram())),
                icon="msg_info",
            ),
            Text(
                text="Редкости: обычный, редкий, эпический, легендарный.",
                subtext="Шансы заданы в плагине и не связаны с Telegram.",
                icon="msg_info",
            ),
        ]

    def _nft_inventory_page(self) -> List[Any]:
        items: List[Any] = [Header(text="Мой инвентарь")]
        if not self._inventory:
            items.append(Text(text="Пока пусто — купите NFT в магазине", icon="msg_info"))
            items.append(Text(text="Открыть магазин", icon="msg_list", create_sub_fragment=self._nft_shop_page))
            return items
        items.append(Text(text="Всего NFT: %d" % len(self._inventory), icon="msg_list"))
        for entry in self._inventory[:40]:
            items.append(
                Text(
                    text=self._nft_label(entry),
                    subtext=self._nft_sub(entry),
                    icon="msg_list",
                    on_click=lambda v, eid=entry.get("id"): self._nft_actions(eid),
                )
            )
        return items

    def _nft_profile_page(self) -> List[Any]:
        slots = max(0, self._int_setting(K_NFT_SLOTS, DEFAULT_NFT_SLOTS))
        items: List[Any] = [Header(text="Витрина в профиле")]
        items.append(Text(text="Слотов: %d, занято: %d" % (slots, len(self._nft_in_profile())), icon="msg_info"))
        for index in range(1, slots + 1):
            entry = next((x for x in self._inventory if int(x.get("slot", 0) or 0) == index), None)
            if entry is None:
                items.append(
                    Text(
                        text="Слот %d — пусто" % index,
                        subtext="Нажмите, чтобы выбрать NFT",
                        icon="msg_edit",
                        on_click=lambda v, i=index: self._pick_nft_for_slot(i),
                    )
                )
            else:
                items.append(
                    Text(
                        text="Слот %d: %s" % (index, self._nft_label(entry)),
                        subtext=self._nft_sub(entry) + " · нажмите, чтобы снять",
                        icon="msg_list",
                        accent=True,
                        on_click=lambda v, eid=entry.get("id"): self._unslot_nft(eid),
                    )
                )
        items.append(Divider())
        items.append(Text(text="Показать витрину", icon="msg_info", accent=True, on_click=self._show_profile_showcase))
        return items

    def _nft_craft_page(self) -> List[Any]:
        need_gifts = max(1, self._int_setting(K_NFT_CRAFT_COST, DEFAULT_NFT_CRAFT_COST))
        need_nft = max(0, self._int_setting(K_NFT_CRAFT_ITEMS, DEFAULT_NFT_CRAFT_ITEMS))
        return [
            Header(text="Крафт NFT"),
            Text(
                text="Скрафтить NFT",
                subtext="Нужно: %d осколков подарков · %d NFT" % (need_gifts, need_nft),
                icon="msg_settings",
                accent=True,
                on_click=self._craft_nft_click,
            ),
            Divider(),
            Text(
                text="Осколков подарков: %d" % self._gift_pool(),
                icon="msg_list",
                on_click=self._add_one_shard,
                subtext="Нажмите, чтобы добавить один осколок (для теста)",
            ),
            Text(
                text="NFT в инвентаре: %d" % len(self._inventory),
                icon="msg_list",
            ),
            Text(
                text="При крафте расходуются самые дешёвые NFT и осколки.",
                icon="msg_info",
            ),
        ]

    def _add_one_shard(self, *args):
        try:
            self.set_setting("gift_fragments", str(self._gift_pool() + 1), reload_settings=True)
            self._toast_ok("Осколков подарков: %d" % (self._gift_pool() + 1))
        except Exception:
            self.logger.exception("add shard failed")

    def _gift_pool(self) -> int:
        return max(0, self._int_setting("gift_fragments", 0))

    def _pick_nft_for_slot(self, slot: int):
        available = [x for x in self._inventory if int(x.get("slot", 0) or 0) == 0]
        if not available:
            self._toast_info("Нет свободных NFT в инвентаре")
            return
        builder = self._dialog()
        if builder is None:
            return
        try:
            names = [self._nft_label(x) for x in available]
            builder.set_title("Слот %d" % slot)

            def on_pick(bld, which):
                bld.dismiss()
                self._slot_nft(available[which].get("id"), slot)

            builder.set_items(names, on_pick)
            builder.set_negative_button("Отмена", lambda b, w: b.dismiss())
            builder.show()
            builder.set_cancelable(True)
        except Exception:
            self.logger.exception("pick nft dialog failed")

    def _slot_nft(self, nft_id: Any, slot: int):
        for item in self._inventory:
            if item.get("id") == nft_id:
                item["slot"] = int(slot)
                self._save_inventory()
                self._push_history("Витрина: " + self._nft_label(item), "слот %d" % slot)
                self._toast_ok("NFT установлен в слот %d" % slot)
                return
        self._toast_info("NFT не найден")

    def _unslot_nft(self, nft_id: Any):
        for item in self._inventory:
            if item.get("id") == nft_id:
                item["slot"] = 0
                self._save_inventory()
                self._toast_info("NFT снят с витрины")
                return

    def _nft_in_profile(self) -> List[Dict[str, Any]]:
        result = [x for x in self._inventory if int(x.get("slot", 0) or 0) > 0]
        return sorted(result, key=lambda x: int(x.get("slot", 0) or 0))

    def _show_profile_showcase(self, *args):
        shown = self._nft_in_profile()
        builder = self._dialog()
        if builder is None:
            return
        try:
            builder.set_title("Витрина профиля")
            if not shown:
                builder.set_message("Витрина пуста.\n\nДобавьте NFT из инвентаря.")
            else:
                lines = []
                for item in shown:
                    lines.append("Слот %d — %s (%s)" % (item.get("slot", 0), item.get("name"), item.get("rarity")))
                builder.set_message("\n".join(lines))
            builder.set_positive_button("Закрыть", lambda b, w: b.dismiss())
            builder.show()
            builder.set_cancelable(True)
        except Exception:
            self.logger.exception("showcase dialog failed")

    # ------------------------------------------------------------------ #
    # Crafting
    # ------------------------------------------------------------------ #
    def _craft_nft_click(self, *args):
        need_gifts = max(1, self._int_setting(K_NFT_CRAFT_COST, DEFAULT_NFT_CRAFT_COST))
        need_nft = max(0, self._int_setting(K_NFT_CRAFT_ITEMS, DEFAULT_NFT_CRAFT_ITEMS))
        if self._gift_pool() < need_gifts:
            self._toast_info("Нужно %d осколков подарков" % need_gifts)
            return
        if len(self._inventory) < need_nft:
            self._toast_info("Нужно %d NFT для крафта" % need_nft)
            return
        builder = self._dialog()
        if builder is None:
            return
        try:
            builder.set_title("Крафт NFT")
            builder.set_message(
                "Будет потрачено: %d осколков подарков и %d NFT.\n\nПродолжить?" % (need_gifts, need_nft)
            )

            def on_confirm(bld, which):
                bld.dismiss()
                self._do_craft(need_gifts, need_nft)

            builder.set_positive_button("Скрафтить", on_confirm)
            builder.set_negative_button("Отмена", lambda b, w: b.dismiss())
            builder.show()
            builder.set_cancelable(True)
        except Exception:
            self.logger.exception("craft dialog failed")

    def _do_craft(self, need_gifts: int, need_nft: int):
        try:
            self.set_setting("gift_fragments", str(self._gift_pool() - need_gifts))
            if need_nft:
                self._inventory.sort(key=lambda x: (int(x.get("value", 0)), int(x.get("slot", 0) or 0)))
                self._inventory = self._inventory[need_nft:]
            crafted = self._make_nft()
            self._inventory.append(crafted)
            self._save_inventory()
            self._push_history("Крафт: " + self._nft_label(crafted), "−%d осколков" % need_gifts)

            builder = self._dialog()
            if builder is None:
                self._toast_ok("Скрафчен: " + self._nft_label(crafted))
                return
            builder.set_title("Крафт готов")
            builder.set_message("Получен NFT:\n\n%s\nРедкость: %s" % (crafted.get("name"), crafted.get("rarity")))
            builder.set_positive_button("Круто", lambda b, w: b.dismiss())
            builder.show()
            builder.set_cancelable(True)
        except Exception:
            self.logger.exception("craft failed")

    # ------------------------------------------------------------------ #
    # NFT purchase
    # ------------------------------------------------------------------ #
    def _buy_nft_click(self, *args):
        self._buy_nft(install=False)

    def _buy_nft_install_click(self, *args):
        self._buy_nft(install=True)

    def _buy_nft(self, install: bool):
        try:
            price_stars = max(0, self._int_setting(K_NFT_PRICE_STARS, DEFAULT_NFT_PRICE_STARS))
            price_gram = max(0.0, self._float_setting(K_NFT_PRICE_GRAM, DEFAULT_NFT_PRICE_GRAM))
            spent = self._spend_amount(price_stars, price_gram, K_NFT_SPEND)
            if spent is None:
                self._toast_info("Недостаточно баланса для NFT")
                return
            nft = self._make_nft()
            self._inventory.append(nft)
            if install:
                free_slot = self._free_slot()
                if free_slot:
                    nft["slot"] = free_slot
            self._save_inventory()
            price = self._price_text(spent)
            self._push_history("Покупка NFT: " + self._nft_label(nft), "−" + price)

            builder = self._dialog()
            if builder is None:
                self._toast_ok("Куплен NFT: " + self._nft_label(nft))
                return
            builder.set_title("NFT куплен")
            builder.set_message(
                "%s\nРедкость: %s\nФон: %s\n\n%s\nОстаток: %s Stars · %s GRAM"
                % (
                    nft.get("name"),
                    nft.get("rarity"),
                    nft.get("backdrop"),
                    "Установлен в слот %d" % nft.get("slot") if nft.get("slot") else "Лежит в инвентаре",
                    self._fmt_stars(self._stars()),
                    self._fmt_gram(self._gram()),
                )
            )
            builder.set_positive_button("Готово", lambda b, w: b.dismiss())
            builder.show()
            builder.set_cancelable(True)
        except Exception:
            self.logger.exception("buy nft failed")

    def _free_slot(self) -> int:
        slots = max(0, self._int_setting(K_NFT_SLOTS, DEFAULT_NFT_SLOTS))
        used = set(int(x.get("slot", 0) or 0) for x in self._inventory)
        for index in range(1, slots + 1):
            if index not in used:
                return index
        return 0

    def _nft_actions(self, nft_id: Any):
        entry = next((x for x in self._inventory if x.get("id") == nft_id), None)
        if entry is None:
            self._toast_info("NFT не найден")
            return
        builder = self._dialog()
        if builder is None:
            return
        try:
            builder.set_title(self._nft_label(entry))
            options = ["Установить в профиль", "Снять с профиля", "Продать (за Stars)", "Удалить"]

            def on_pick(bld, which):
                bld.dismiss()
                if which == 0:
                    slot = self._free_slot()
                    if not slot:
                        self._toast_info("Нет свободного слота в витрине")
                        return
                    self._slot_nft(nft_id, slot)
                elif which == 1:
                    self._unslot_nft(nft_id)
                elif which == 2:
                    self._sell_nft(entry)
                else:
                    self._delete_nft(entry)

            builder.set_items(options, on_pick)
            builder.set_negative_button("Закрыть", lambda b, w: b.dismiss())
            builder.show()
            builder.set_cancelable(True)
        except Exception:
            self.logger.exception("nft actions dialog failed")

    def _sell_nft(self, entry: Dict[str, Any]):
        try:
            value = max(0, int(entry.get("value", 0)))
            self.set_setting(K_STARS, str(self._stars() + value), reload_settings=True)
            self._inventory = [x for x in self._inventory if x.get("id") != entry.get("id")]
            self._save_inventory()
            self._push_history("Продажа NFT: " + self._nft_label(entry), "+%s Stars" % self._fmt_stars(value))
            self._toast_ok("Получено %s Stars" % self._fmt_stars(value))
        except Exception:
            self.logger.exception("sell nft failed")

    def _delete_nft(self, entry: Dict[str, Any]):
        self._inventory = [x for x in self._inventory if x.get("id") != entry.get("id")]
        self._save_inventory()
        self._toast_info("NFT удалён")

    # ------------------------------------------------------------------ #
    # Spending
    # ------------------------------------------------------------------ #
    def _spend_amount(self, price_stars: int, price_gram: float, switch_key: str, respect_switch: bool = False):
        if respect_switch:
            if (not self.get_setting(K_SPEND, True)) or (not self.get_setting(switch_key, True)):
                return (0, 0.0)
        mode = min(2, max(0, self._int_setting(K_CUR, 0)))
        stars = self._stars()
        gram = self._gram()

        if mode == 0:
            if stars < price_stars:
                return None
            self.set_setting(K_STARS, str(stars - price_stars))
            return (price_stars, 0.0)

        if mode == 1:
            if gram + 1e-9 < price_gram:
                return None
            self.set_setting(K_GRAM, self._fmt_gram(gram - price_gram))
            return (0, price_gram)

        if stars >= price_stars:
            self.set_setting(K_STARS, str(stars - price_stars))
            return (price_stars, 0.0)

        need_gram = 0.0
        if price_stars > 0:
            need_gram = (price_stars - stars) * price_gram / price_stars
        else:
            need_gram = price_gram
        if gram + 1e-9 < need_gram:
            return None
        self.set_setting(K_STARS, "0")
        self.set_setting(K_GRAM, self._fmt_gram(gram - need_gram))
        return (stars, need_gram)

    def _spend_gift(self):
        return self._spend_amount(
            max(0, self._int_setting(K_PRICE_STARS, DEFAULT_PRICE_STARS)),
            max(0.0, self._float_setting(K_PRICE_GRAM, DEFAULT_PRICE_GRAM)),
            K_SPEND,
        )

    # ------------------------------------------------------------------ #
    # Chat context menu
    # ------------------------------------------------------------------ #
    def _on_menu_gift(self, context: Dict[str, Any]):
        try:
            dialog_id = context.get("dialog_id")
            target = self._target_name(context)
            self._toast_info("Меню: %s | ключи: %s" % (target, ",".join(list(context.keys())[:8])))
            self._open_gift_dialog(dialog_id, target)
        except Exception as exc:
            try:
                self._toast_info("Ошибка меню: %s: %s" % (type(exc).__name__, exc))
            except Exception:
                pass

    def _on_menu_nft(self, context: Dict[str, Any]):
        try:
            self._open_nft_gift_dialog(context.get("dialog_id"), self._target_name(context))
        except Exception:
            self.logger.exception("nft menu failed")

    def _target_name(self, context: Dict[str, Any]) -> str:
        try:
            chat = context.get("chat")
            if chat is not None:
                title = getattr(chat, "title", None)
                if title:
                    return str(title)
            user = context.get("user")
            if user is not None:
                first = getattr(user, "first_name", None)
                if first:
                    last = getattr(user, "last_name", None)
                    return str(first) + (" " + str(last) if last else "")
        except Exception:
            pass
        return "получатель"

    def _open_gift_dialog(self, dialog_id: Any, target: str):
        builder = self._dialog()
        if builder is None:
            self._toast_info("Не удалось открыть окно")
            return
        try:
            price_stars = max(0, self._int_setting(K_PRICE_STARS, DEFAULT_PRICE_STARS))
            price_gram = max(0.0, self._float_setting(K_PRICE_GRAM, DEFAULT_PRICE_GRAM))
            mode_name = CURRENCY_ITEMS[min(2, max(0, self._int_setting(K_CUR, 0)))]
            builder.set_title("Подарить подарок")
            builder.set_message(
                "Кому: %s\n\nБаланс: %s Stars · %s GRAM\nЦена: %s Stars / %s GRAM (%s)"
                % (
                    target,
                    self._fmt_stars(self._stars()),
                    self._fmt_gram(self._gram()),
                    self._fmt_stars(price_stars),
                    self._fmt_gram(price_gram),
                    mode_name,
                )
            )

            def on_send(bld, which):
                bld.dismiss()
                self._send_gift(dialog_id, target)

            builder.set_positive_button("Подарить", on_send)
            builder.set_negative_button("Отмена", lambda b, w: b.dismiss())
            builder.show()
            builder.set_cancelable(True)
        except Exception:
            self.logger.exception("gift dialog failed")

    def _open_nft_gift_dialog(self, dialog_id: Any, target: str):
        available = [x for x in self._inventory if int(x.get("slot", 0) or 0) == 0]
        if not available:
            self._toast_info("Нет свободных NFT для подарка")
            return
        builder = self._dialog()
        if builder is None:
            return
        try:
            builder.set_title("Подарить NFT → %s" % target)

            def on_pick(bld, which):
                bld.dismiss()
                self._send_nft_gift(dialog_id, target, available[which])

            builder.set_items([self._nft_label(x) for x in available], on_pick)
            builder.set_negative_button("Отмена", lambda b, w: b.dismiss())
            builder.show()
            builder.set_cancelable(True)
        except Exception:
            self.logger.exception("nft gift dialog failed")

    def _send_nft_gift(self, dialog_id: Any, target: str, entry: Dict[str, Any]):
        try:
            self._inventory = [x for x in self._inventory if x.get("id") != entry.get("id")]
            self._save_inventory()
            title = "NFT для %s" % target
            self._push_history(title, self._nft_label(entry))
            text = "%s\n%s\nОстаток NFT: %d" % (title, self._nft_label(entry), len(self._inventory))
            self._send_text(dialog_id, text)

            builder = self._dialog()
            if builder is None:
                self._toast_ok("NFT подарен")
                return
            builder.set_title("NFT подарен")
            builder.set_message(
                "%s получил(а) %s\n\nОстаток NFT: %d" % (target, self._nft_label(entry), len(self._inventory))
            )
            builder.set_positive_button("Готово", lambda b, w: b.dismiss())
            builder.show()
            builder.set_cancelable(True)
        except Exception:
            self.logger.exception("send nft gift failed")

    # ------------------------------------------------------------------ #
    # Gift flow
    # ------------------------------------------------------------------ #
    def _send_gift(self, dialog_id: Any, target: str):
        try:
            spent = self._spend_gift()
            if spent is None:
                self._toast_info("Недостаточно баланса")
                return
            price_text = self._price_text(spent)
            title = "Подарок для %s" % target
            self._push_history(title, "−" + price_text)
            self.set_setting("gift_fragments", str(self._gift_pool() + 1))
            text = "%s — %s\nОстаток: %s Stars · %s GRAM" % (
                title,
                price_text,
                self._fmt_stars(self._stars()),
                self._fmt_gram(self._gram()),
            )
            self._send_text(dialog_id, text)
            run_on_ui_thread(lambda: self._show_gift_result(target))
        except Exception:
            self.logger.exception("send gift failed")

    def _show_gift_result(self, target: str):
        try:
            builder = self._dialog()
            if builder is None:
                return
            builder.set_title("Подарок отправлен")
            builder.set_message(
                "%s получил(а) подарок!\n\nНовый баланс: %s Stars · %s GRAM\nОсколков подарков: %d"
                % (target, self._fmt_stars(self._stars()), self._fmt_gram(self._gram()), self._gift_pool())
            )
            builder.set_positive_button("Готово", lambda b, w: b.dismiss())
            builder.show()
            builder.set_cancelable(True)
        except Exception:
            self.logger.exception("gift result dialog failed")

    # ------------------------------------------------------------------ #
    # Sending text
    # ------------------------------------------------------------------ #
    def _random_id(self) -> int:
        value = random.getrandbits(62)
        return -value if random.getrandbits(1) else value

    def _send_text(self, dialog_id: Any, text: str):
        try:
            from client_utils import get_messages_controller
            from org.telegram.tgnet import TLRPC

            controller = get_messages_controller()
            if controller is None or dialog_id is None:
                self._toast_ok("Сохранено визуально")
                return
            req = TLRPC.TL_messages_sendMessage()
            req.peer = self._make_peer(dialog_id)
            req.message = text
            req.random_id = self._random_id()
            controller.sendMessage(req, False, False, None, 0, None, 0, 0, None)
        except Exception:
            self.logger.exception("send gift message failed")
            self._toast_ok("Сохранено визуально")

    def _make_peer(self, dialog_id: Any):
        from org.telegram.tgnet import TLRPC

        text = str(dialog_id)
        if text.startswith("@"):
            peer = TLRPC.TL_inputPeerUsername()
            peer.username = text[1:]
            return peer
        value = int(text)
        if value > 0:
            peer = TLRPC.TL_inputPeerUser()
            peer.user_id = value
            return peer
        if value > -1000000000000:
            peer = TLRPC.TL_inputPeerChat()
            peer.chat_id = -value
            return peer
        peer = TLRPC.TL_inputPeerChannel()
        peer.channel_id = -value - 1000000000000
        return peer